{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["electron", "shared", "vite.config.mts", "vite.electron.config.mts"],
  "exclude": ["reference", "node_modules", "dist", "dist-electron"]
}
