{
  "name": "icycleaner",
  "productName": "IcyTweaker",
  "version": "0.1.10",
  "private": true,
  "description": "Windows 10/11 tweaker and cleaner for gamers",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build && vite build -c vite.electron.config.mts",
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "dist": "npm run build && node scripts/dist.mjs"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "clsx": "^2.1.1",
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "build": {
    "appId": "app.icycleaner.desktop",
    "productName": "IcyTweaker",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "!**/*.map",
      "package.json"
    ],
    "npmRebuild": false,
    "win": {
      "target": "nsis",
      "icon": "build/icon.png",
      "requestedExecutionLevel": "requireAdministrator"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "IcyTweaker",
      "include": "build/installer.nsh",
      "deleteAppDataOnUninstall": false,
      "artifactName": "IcyTweaker-Setup-${version}.${ext}",
      "runAfterFinish": true
    }
  },
  "updateRepo": "P0PP3D/IcyTweaker",
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
